# Server
PORT=3009
DATABASE_TYPE=
ALLOWED_ORIGINS=
APP_VERSION=All

# MongoDB
MONGO_URL=mongodb://0.0.0.0:27017/lesson_points_tracker

# SQL
SQL_DB_TYPE=mysql
SQL_PORT=3306
SQL_HOST=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DATABASE_NAME=

# JWT / token encryption
# Must match the auth-service's values exactly (JWT_ENCRYPTION_PRIVATE_KEY is base64url-encoded)
JWT_ENCRYPTION_PRIVATE_KEY=
JWT_SIGNIN_PRIVATE_KEY=
JWT_EXPIRATION=1h

# Auth service
AUTH_SERVICE_TOKEN_STATUS_URL=http://localhost:8000/api/v1/virtualId/tokenStatus
